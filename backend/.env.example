# Copy this file to backend/.env and fill in YOUR values.  Never commit backend/.env.
#
# 1) Database connection.
# Hackathon / single-laptop default: SQLite, no separate database server required.
DATABASE_URL=sqlite:///./kisansaathi.db
# PostgreSQL alternative (create the database first, then uncomment and configure):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/kisansaathi

# 2) Mandi price provider for the hackathon. Keyless community API covers 5 states.
MANDI_API_BASE_URL=https://mandi-api.onrender.com/v1
# Optional fallback: official data.gov.in key, only if your key works.
DATA_GOV_API_KEY=YOUR_DATA_GOV_IN_API_KEY

# 3) Optional settings - the defaults are fine.
# MODEL_ID=wambugu71/crop_leaf_diseases_vit
# MODEL_REVISION=2b77473a26a2974a9bfb7f0c7880ed84f9b302df
# CONFIDENCE_MIN=0.60
# MAX_UPLOAD_MB=10
# PRELOAD_MODEL=1
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Automatic keyless Mandi Price API sync (five supported states).
# While this backend process is running, refresh on startup and every 24 hours.
# Use a single Uvicorn worker with this in-process scheduler; for multiple workers,
# disable it and configure one external cron/scheduled job instead.
MANDI_AUTO_REFRESH_ENABLED=true
MANDI_REFRESH_ON_STARTUP=true
MANDI_REFRESH_INTERVAL_HOURS=24

# 4) Safety limits (defaults are fine). See README "Security".
# RATE_LIMIT_ENABLED=1
# TRUST_PROXY_HEADERS=0          # set to 1 only behind a reverse proxy such as Hugging Face Spaces
# PIN_FAILURES_PER_HOUR=5
# LISTING_EXPIRY_DAYS=30
# PRICE_RETENTION_DAYS=730

# 5) Phone verification. off = PIN only. console = demo: the code is printed in this terminal.
# OTP_PROVIDER=off
# SECRET_KEY=PUT_A_LONG_RANDOM_TEXT_HERE
